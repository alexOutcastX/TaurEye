# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Python / data engine
.venv
__pycache__/
*.pyc
# SQLite spine + raw downloaded bhavcopies (regenerated) — never commit
backend/data/
backend/saved_screens.json

# Published client data (regenerated by `taureye export`; uploaded to the host/
# CDN — not committed: ohlc.json alone is ~40 MB).
public/data/

# Capacitor / Android build outputs (the android/ project itself IS committed
# so CI can build it; only generated/build files are ignored — Capacitor adds
# its own android/.gitignore for those).
.gradle
android/app/build
android/build
android/.idea
android/local.properties
android/app/src/main/assets/public
android/app/src/main/assets/capacitor.config.json
android/app/src/main/res/xml/config.xml

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- SECRETS / KEYS — never commit ----
.env
.env.*
!.env.example
*.key
*.pem
*.key.pub
ssh-key-*
id_rsa*
key/

# Build artifacts / packages / logs
*.apk
*.aab
android/build-log*.txt
backend/data/*.db
backend/data/*.db-*

# editor backups
*~
