# TaurEye — environment variables (copy to .env / set in CI).
# NEVER commit a filled-in .env. Only this template is committed.

# ---------- Data source (build-time) ----------
# Production web + APK build the static bundle. Leave unset for the legacy /api.
VITE_DATA_SOURCE=local
# Where the JSON bundle is served (nginx serves it under /data on the VM).
VITE_DATA_BASE=http://161.118.174.177/data
VITE_CANDLE_BASE=http://161.118.174.177/data

# ---------- AI delivery mode (build-time) — see docs/TWO-VERSIONS.md ----------
# 'cache' (default, or anything not "live"): AI analysis + reports come ONLY from
#   the nightly bundle (reports/<SYMBOL>.json) — ₹0, no Edge Functions, no
#   Anthropic. Use this for the self-hosted / cost-zero build.
# 'live': same cache first, but symbols with no cached file fall back to the
#   ai-analysis / ai-report Edge Functions (Anthropic). Use this for the legacy
#   "Oracle VM + Cloud Supabase + Anthropic" build (needs ANTHROPIC_API_KEY set
#   on the Edge Functions). In CI, set the repo variable AI_MODE.
VITE_AI_MODE=cache

# ---------- Supabase (accounts, cloud wallet, AI/payments) ----------
# Frontend keys — safe to ship (the anon key is public by design; RLS protects data).
# Get these from: Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Social-login buttons to show (comma list of enabled Supabase providers).
# Unset = show all. Set after you enable each provider in Supabase, e.g.:
#   VITE_OAUTH_PROVIDERS=google,github
VITE_OAUTH_PROVIDERS=

# ---------- Edge Function secrets (set with `supabase secrets set`, NOT here) ----------
# These live ONLY on the server; never expose them to the client / Vite.
#   ANTHROPIC_API_KEY=sk-ant-...           # ai-analysis (LLM key, server-only)
#   RAZORPAY_WEBHOOK_SECRET=...            # razorpay-webhook signature check
#   ADMOB_SSV_ENFORCE=true                 # turn on AdMob signature verification
# (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
#  automatically into Edge Functions by the platform.)

# ---------- Ads (build-time; empty = ads off, slots show dev placeholder) ----------
# Web — Google AdSense:
VITE_ADSENSE_CLIENT=                 # ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_SLOT_SCREENER=          # AdSense ad-unit id for the screener slot
VITE_ADSENSE_SLOT_WALLET=            # AdSense ad-unit id for the wallet slot
# App — AdMob (native; needs `cap sync` + APK rebuild to take effect):
VITE_ADMOB_BANNER_ANDROID=          # ca-app-pub-XXXXXXXX/YYYYYYYY

# ---------- OTA (mobile) ----------
# Set as the GitHub secret CAPGO_TOKEN + repo variable CAPGO_ENABLED=true.
