# TaurEye web — multi-stage: build the static SPA, then serve it with nginx.
# Build-time VITE_* args bake the data-source + Supabase config into dist/.
# The /data JSON bundle is NOT baked in — it is a runtime volume written by the
# dataengine container and served from /usr/share/nginx/html/data.
#
# Build context is the REPO ROOT. A dedicated Dockerfile.web.dockerignore sits
# next to this file so `src/` is included (the root .dockerignore excludes it).

FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Production = static LOCAL data mode (no live /api). Empty data bases => the SPA
# reads the bundle same-origin at /data (nginx serves the dataengine's export).
ARG VITE_DATA_SOURCE=local
ARG VITE_DATA_BASE=
ARG VITE_CANDLE_BASE=
ARG VITE_AI_MODE=cache
ARG VITE_SUPABASE_URL=
ARG VITE_SUPABASE_ANON_KEY=
ARG VITE_OAUTH_PROVIDERS=
ARG VITE_ADSENSE_CLIENT=
ARG VITE_ADSENSE_SLOT_SCREENER=
ARG VITE_ADSENSE_SLOT_WALLET=
ENV VITE_DATA_SOURCE=$VITE_DATA_SOURCE \
    VITE_DATA_BASE=$VITE_DATA_BASE \
    VITE_CANDLE_BASE=$VITE_CANDLE_BASE \
    VITE_AI_MODE=$VITE_AI_MODE \
    VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    VITE_OAUTH_PROVIDERS=$VITE_OAUTH_PROVIDERS \
    VITE_ADSENSE_CLIENT=$VITE_ADSENSE_CLIENT \
    VITE_ADSENSE_SLOT_SCREENER=$VITE_ADSENSE_SLOT_SCREENER \
    VITE_ADSENSE_SLOT_WALLET=$VITE_ADSENSE_SLOT_WALLET
RUN npm run build

FROM nginx:1.27-alpine
# Reuse the existing site config (SPA fallback + /data bundle with CORS + gzip).
COPY deploy/nginx-taureye.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
