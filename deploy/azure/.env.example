# TaurEye APP-stack config for the Azure VM. Copy to deploy/azure/.env (gitignored).
# The Supabase stack has its OWN .env in ./supabase-docker/.env — keep them separate.

# Public IP (or domain later) of this Azure VM. Baked into the web build so the
# browser can reach Supabase auth/REST at http://<IP>:8000. REQUIRED.
AZURE_PUBLIC_IP=

# Self-hosted Supabase anon key — copy the ANON_KEY from ./supabase-docker/.env. REQUIRED.
VITE_SUPABASE_ANON_KEY=

# AI delivery: cache (default, ₹0, no Edge Functions) or live. Self-host = cache.
VITE_AI_MODE=cache

# Optional: comma list of enabled OAuth providers to show (e.g. google,github).
VITE_OAUTH_PROVIDERS=
