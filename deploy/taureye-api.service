# systemd unit for the TaurEye backend (uvicorn).
# Bound to 127.0.0.1 only — Caddy is the public entry point and proxies /api.
# Copy to /etc/systemd/system/taureye-api.service (the setup script does this,
# substituting USER), then: sudo systemctl enable --now taureye-api
[Unit]
Description=TaurEye API (uvicorn)
After=network.target

[Service]
User=USER
WorkingDirectory=/home/USER/taureye
EnvironmentFile=/home/USER/taureye/.env.server
ExecStart=/home/USER/taureye/.venv/bin/python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
